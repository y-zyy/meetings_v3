# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://meetings:meetings@postgres:5432/meetings
# uvicorn 프로세스당 풀 (4 workers x 15 = 60)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_VISIBILITY_TIMEOUT=14400
CELERY_TASK_SOFT_TIME_LIMIT=7800
CELERY_TASK_TIME_LIMIT=7920
# GPU 단계: GPU 슬롯 수(+1) 로 맞춘다 (대기열은 Redis 에 두고 HTTP 안에 쌓지 않음)
INGEST_WORKER_CONCURRENCY=4
ASR_WORKER_CONCURRENCY=2
DIARIZE_WORKER_CONCURRENCY=2
# LLM 단계: POSTPROCESS x LLM_POSTPROCESS_PARALLELISM + MINUTES <= LLM 서버 동시 시퀀스 수
POSTPROCESS_WORKER_CONCURRENCY=6
MINUTES_WORKER_CONCURRENCY=10

# ── Security ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── File Storage ──────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=500
UPLOAD_CHUNK_SIZE_MB=4

# ── ASR API ───────────────────────────────────────────────
# Set OPENAI_API_KEY to use OpenAI Whisper; otherwise uses local server.
OPENAI_API_KEY=
ASR_API_URL=http://asr-server:9000/transcribe
ASR_API_KEY=
ASR_FILE_FIELD=file
ASR_RESPONSE_FIELD=text
ASR_TIMEOUT=7200
# 후처리 이후 정렬/화자 분리 (기본: ASR_API_URL 의 /transcribe -> /align_diarize)
ASR_DIARIZE_ENABLED=true
ASR_DIARIZE_API_URL=
ASR_MIN_SPEAKERS=
ASR_MAX_SPEAKERS=

# ── WhisperX server ───────────────────────────────────────
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_BATCH_SIZE=16
WHISPERX_MAX_BATCH_SIZE=16
WHISPERX_MAX_CONCURRENCY=1
WHISPERX_UPLOAD_CHUNK_SIZE_MB=4
WHISPERX_MAX_UPLOAD_SIZE_MB=500
# 화자 분리(pyannote) — HuggingFace 토큰 필요 (pyannote/speaker-diarization-community-1 등 약관 동의 필요)
HF_TOKEN=
WHISPERX_DIARIZE=true

# ── LLM API (OpenAI-compatible) ───────────────────────────
LLM_API_BASE_URL=http://llm-server:8000/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TIMEOUT=600
LLM_MAX_TOKENS=4096
# STT 후처리: 발화 단위 청크(글자 수) / 회의 1건당 병렬 호출 수
LLM_POSTPROCESS_ENABLED=true
LLM_POSTPROCESS_CHUNK_CHARS=2500
LLM_POSTPROCESS_PARALLELISM=4

# ── Admin default credentials (first run only) ────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@local

